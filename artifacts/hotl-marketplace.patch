+      if (!listing || listing.askingPriceCents == null) return null;
+      return { transferId: t.id, askCents: listing.askingPriceCents, completedCents: t.amountCents, differenceCents: t.amountCents - listing.askingPriceCents };
+    }).filter(Boolean);
+    const failures = {};
+    for (const t of state.transfers) {
+      if (t.freeze?.reason) failures[t.freeze.reason] = (failures[t.freeze.reason] || 0) + 1;
+      if (t.state === "cancelled" || t.state === "cancelled_pending_provider") failures[t.state] = (failures[t.state] || 0) + 1;
+    }
+    return {
+      definitions: {
+        timeToFirstOffer: "Among listings that reached active status, hours from activation to the first offer that was accepted into the book. Denominator is listings that became active. Listings with no offer are excluded from the average and counted in withoutOffer.",
+        proportionWithOffers: "Listings that became active and received at least one offer, divided by listings that became active. Redeemed or withdrawn listings stay in the denominator.",
+        offerToTransfer: "Offers that were selected into a transfer, divided by offers that were recorded. Withdrawn and outdated offers stay in the denominator.",
+        completedTransfers: "Transfers reconciled only after both assignment confirmation and provider funds release, divided by transfers opened. Redemptions are not completions.",
+        redemptions: "Listings marked redeemed. Counted separately from sales.",
+        priceGap: "Completed price minus asking price, only on reconciled sales. Not a return.",
+      },
+      activated: activated.length,
+      withOffer: withOffer.length,
+      withoutOffer: activated.length - withOffer.length,
+      proportionWithOffers: activated.length ? withOffer.length / activated.length : null,
+      meanHoursToFirstOffer: withOffer.length ? withOffer.reduce((a, l) => a + (Date.parse(l.firstOfferAt) - Date.parse(l.activatedAt)) / 36e5, 0) / withOffer.length : null,
+      offers: state.offers.length,
+      offerToTransfer: state.offers.length ? selected.length / state.offers.length : null,
+      transfersOpened: opened,
+      completedSales: sold.length,
+      completionRatio: opened ? sold.length / opened : null,
+      meanHoursToComplete: sold.length ? sold.reduce((a, t) => a + (Date.parse(t.reconciledAt) - Date.parse(t.createdAt)) / 36e5, 0) / sold.length : null,
+      priceGaps: gaps,
+      redemptions: redeemed.length,
+      failures,
+      eligibleOffers: eligibleOffers.length,
+    };
+  }
+
+  function buildView(actorId) {
+    sweep();
+    const isReviewer = reviewer(actorId);
+    const catalog = state.listings.filter((l) => l.status === "active").map(publicListing);
+    const mine = state.listings.filter((l) => l.ownerId === actorId).map((l) => ownerListing(actorId, l));
+    const holdingRows = state.holdings.filter((h) => h.ownerId === actorId);
+    const offerRows = state.offers.filter((o) => o.buyerId === actorId || o.sellerId === actorId || isReviewer).map((o) => memberOffer(actorId, o));
+    const transferRows = state.transfers.filter((t) => t.sellerId === actorId || t.buyerId === actorId || isReviewer).map((t) => memberTransfer(actorId, t));
+    const board = state.requests.filter((r) => r.status === "open" && (!r.expiresAt || r.expiresAt > now().toISOString())).map(publicRequest);
+    const myRequests = state.requests.filter((r) => r.buyerId === actorId).map(publicRequest);
+    const threads = state.threads.filter((t) => t.buyerId === actorId || t.sellerId === actorId || isReviewer).map((t) => ({
+      ...t,
+      messages: state.messages.filter((m) => m.threadId === t.id).map((m) => ({ id: m.id, authorId: m.authorId, text: m.text, at: m.at, mine: m.authorId === actorId })),
+    }));
+    const matches = [];
+    for (const request of state.requests) {
+      if (request.buyerId !== actorId && !isReviewer) continue;
+      for (const listing of state.listings) {
+        const m = matchOne(listing, request);
+        if (m) matches.push({ ...m, askingPriceCents: listing.askingPriceCents, countyName: listing.countyName, state: listing.state, certificateNumber: listing.certificateNumber });
+      }
+    }
+    const tasks = [];
+    for (const o of state.offers) {
+      if (o.sellerId === actorId && o.status === "open") tasks.push({ kind: "offer", text: "An offer needs a response.", ref: o.id });
+    }
+    for (const l of state.listings) {
+      if (l.ownerId === actorId && l.status === "in_review") tasks.push({ kind: "review", text: "A listing is in review.", ref: l.id });
+      if (l.ownerId === actorId && l.reviewFailureReason && l.status === "draft") tasks.push({ kind: "evidence", text: l.reviewFailureReason, ref: l.id });
+      if (l.ownerId === actorId && l.status === "active" && expiredCheck(l)) tasks.push({ kind: "stale", text: "Status check expired. New offers are blocked.", ref: l.id });
+    }
+    for (const t of state.transfers) {
+      if ((t.sellerId === actorId || t.buyerId === actorId || isReviewer) && t.state === "open") tasks.push({ kind: "transfer", text: "A transfer has steps still open.", ref: t.id });
+      if ((t.sellerId === actorId || t.buyerId === actorId) && t.state === "frozen") tasks.push({ kind: "frozen", text: `Transfer frozen: ${t.freeze?.reason || "see the case"}.`, ref: t.id });
+    }
+    return {
+      actorId,
+      reviewer: isReviewer,
+      mode: state.mode,
+      flags: clone(state.flags),
+      provider: { configured: state.provider.configured, name: state.provider.configured ? state.provider.name : null },
+      enabledCounties: state.policies.filter((p) => p.enabled).map((p) => ({ countyFips: p.countyFips, state: p.state, countyName: p.countyName, validUntil: p.validUntil, legalReviewRef: p.legalReviewRef })),
+      policies: isReviewer ? clone(state.policies) : state.policies.filter((p) => p.enabled).map((p) => ({ countyFips: p.countyFips, state: p.state, countyName: p.countyName, instrument: p.instrument, enabled: p.enabled, validUntil: p.validUntil })),
+      catalog,
+      listings: mine,
+      holdings: holdingRows,
+      offers: offerRows,
+      transfers: transferRows,
+      requests: board,
+      myRequests,
+      threads,
+      matches,
+      watches: state.watches.filter((w) => w.userId === actorId),
+      notifications: state.notifications.filter((n) => n.userId === actorId),
+      preferences: state.preferences[actorId] || { matchAlerts: false },
+      tasks,
+      reports: isReviewer ? state.reports : [],
+      countyRequests: isReviewer ? state.countyRequests : state.countyRequests.filter((c) => c.actorId === actorId),
+      reviewQueue: isReviewer ? state.listings.filter((l) => l.status === "in_review" && l.ownerId !== actorId).map((l) => ownerListing(actorId, l)) : [],
+      analytics: isReviewer ? analytics() : null,
+      sources: RESEARCH_SOURCES,
+    };
+  }
+
+  async function command(actor, name, payload = {}, opts = {}) {
+    if (!actor?.id) return { ok: false, code: "FORBIDDEN", message: "Sign in is required." };
+    const idem = opts.idempotencyKey ? `${actor.id}:${name}:${opts.idempotencyKey}` : null;
+    return tx(async () => {
+      if (idem && state.idempotency[idem]) return { ok: true, duplicate: true, data: state.idempotency[idem] };
+      let rated = false;
+      if (name !== "providerEvent") {
+        try { bumpRate(actor.id); rated = true; } catch (err) {
+          return { ok: false, code: err.code || "ERROR", message: err.message };
+        }
+      }
+      const backup = clone(state);
+      try {
+        sweep();
+        const fn = commands[name];
+        if (!fn) return { ok: false, code: "BAD_COMMAND", message: "Unknown marketplace command." };
+        const data = await fn(actor, payload || {});
+        if (idem) state.idempotency[idem] = data;
+        return { ok: true, data };
+      } catch (err) {
+        const rate = state.rate;
+        const clock = state.clock;
+        for (const key of Object.keys(state)) delete state[key];
+        Object.assign(state, backup);
+        if (rated) state.rate = rate;
+        state.clock = clock;
+        return { ok: false, code: err.code || "ERROR", message: err.message || "The marketplace could not save that." };
+      }
+    });
+  }
+
+  return {
+    command,
+    view(actorId) { return buildView(actorId); },
+    setClock(iso) { state.clock = iso; },
+    snapshot() {
+      const copy = clone(state);
+      delete copy.rate;
+      for (const ev of copy.evidence) delete ev.bytes;
+      return copy;
+    },
+    setAudience(audience) {
+      state.audience = audience === "member" ? "member" : "review";
+    },
+    async signProvider(body) {
+      const secret = secrets.get("provider");
+      if (!secret) return null;
+      const raw = JSON.stringify(body);
+      return { raw, signature: await hmacHex(secret, raw) };
+    },
+  };
+}
+
+async function hmacHex(secret, message) {
+  const enc = new TextEncoder();
+  const key = await crypto.subtle.importKey("raw", enc.encode(secret), { name: "HMAC", hash: "SHA-256" }, false, ["sign"]);
+  const sig = await crypto.subtle.sign("HMAC", key, enc.encode(message));
+  return [...new Uint8Array(sig)].map((b) => b.toString(16).padStart(2, "0")).join("");
+}
+
+function safeEqual(a, b) {
+  if (a.length !== b.length) return false;
+  let out = 0;
+  for (let i = 0; i < a.length; i++) out |= a.charCodeAt(i) ^ b.charCodeAt(i);
+  return out === 0;
+}
+
+export function catalogQuery(rows, q) {
+  const text = String(q.q || "").trim().toLowerCase();
+  return rows.filter((row) => {
+    if (q.state && row.state !== String(q.state).toUpperCase()) return false;
+    if (q.countyFips && row.countyFips !== q.countyFips) return false;
+    if (q.year && Number(row.certificateYear) !== Number(q.year)) return false;
+    if (q.priceMinCents != null && row.askingPriceCents < q.priceMinCents) return false;
+    if (q.priceMaxCents != null && row.askingPriceCents > q.priceMaxCents) return false;
+    if (q.availableOnly && row.statusCheckExpired) return false;
+    if (q.freshDays && row.statusCheckedOn) {
+      const age = (Date.parse(q.today || new Date().toISOString().slice(0, 10)) - Date.parse(row.statusCheckedOn)) / 86400000;
+      if (age > Number(q.freshDays)) return false;
+    }
+    if (!text) return true;
+    const hay = [row.countyName, row.state, row.certificateNumber, row.apn, row.address, row.countyFips].filter(Boolean).join(" ").toLowerCase();
+    return text.split(/\s+/).every((part) => hay.includes(part));
+  });
+}
diff --git a/src/marketplace/identity.js b/src/marketplace/identity.js
new file mode 100644
index 0000000..28b15e6
--- /dev/null
+++ b/src/marketplace/identity.js
@@ -0,0 +1,51 @@
+/** Certificate identity. Leading zeros are significant and must be kept. */
+
+export function requireFips(value) {
+  const s = String(value ?? "").trim();
+  if (!/^\d{5}$/.test(s)) {
+    const err = new Error("County FIPS must be exactly 5 digits, including leading zeros.");
+    err.code = "BAD_FIPS";
+    throw err;
+  }
+  return s;
+}
+
+export function requireCertNumber(value) {
+  const s = String(value ?? "").trim();
+  if (!s || s.length > 64) {
+    const err = new Error("Certificate number is required and is stored as text so leading zeros stay intact.");
+    err.code = "BAD_CERTIFICATE";
+    throw err;
+  }
+  if (/[<>]/.test(s)) {
+    const err = new Error("Certificate number cannot include markup.");
+    err.code = "BAD_CERTIFICATE";
+    throw err;
+  }
+  return s;
+}
+
+export function requireYear(value) {
+  const n = Number(value);
+  if (!Number.isInteger(n) || n < 1900 || n > 2100) {
+    const err = new Error("Certificate year must be a four-digit year.");
+    err.code = "BAD_YEAR";
+    throw err;
+  }
+  return n;
+}
+
+export function certificateKey({ countyFips, certificateYear, certificateNumber }) {
+  return `${requireFips(countyFips)}|${requireYear(certificateYear)}|${requireCertNumber(certificateNumber).toUpperCase()}`;
+}
+
+export const INSTRUMENT = "tax_lien_certificate";
+
+export function requireInstrument(value) {
+  if (value !== INSTRUMENT) {
+    const err = new Error("This release lists only whole tax-lien certificates. Deeds, fractions, tokens, pools, and loans are out of scope.");
+    err.code = "BAD_INSTRUMENT";
+    throw err;
+  }
+  return value;
+}
diff --git a/src/marketplace/liveHandoff.js b/src/marketplace/liveHandoff.js
new file mode 100644
index 0000000..42b4cde
--- /dev/null
+++ b/src/marketplace/liveHandoff.js
@@ -0,0 +1,58 @@
+/**
+ * Later cutover from the public site.
+ * handsontaxliens.com/marketplace/ is a research catalog of county open-data
+ * lien records. Its own copy says each entry is not an offer of sale.
+ * This mapper only prepares an unconfirmed draft. It does not save a listing,
+ * and it drops estimated property value on purpose.
+ */
+
+function text(value, max) {
+  if (value == null) return "";
+  return String(value).replace(/\u0000/g, "").trim().slice(0, max);
+}
+
+function httpsUrl(value) {
+  const s = text(value, 300);
+  return /^https:\/\//.test(s) ? s : "";
+}
+
+function money(value) {
+  if (value == null || value === "") return "";
+  const s = String(value).trim().replace(/[$,\s]/g, "");
+  if (!/^\d+(\.\d{1,2})?$/.test(s)) return "";
+  const [d, c = ""] = s.split(".");
+  return `${d}.${c.padEnd(2, "0").slice(0, 2)}`;
+}
+
+export function publicCatalogToDraft(row) {
+  if (!row || typeof row !== "object") {
+    return { ok: false, code: "BAD_RECORD", message: "The public catalog did not send a record." };
+  }
+  const state = text(row.state, 2).toUpperCase();
+  const countyName = text(row.countyName || row.county, 80);
+  if (!/^[A-Z]{2}$/.test(state) || !countyName) {
+    return { ok: false, code: "BAD_RECORD", message: "A public catalog row needs a county and a two-letter state before a draft can open." };
+  }
+  const prefill = {
+    source: "public-catalog",
+    sourceUrl: httpsUrl(row.sourceUrl),
+    sourceLabel: text(row.sourceLabel, 120) || "Public research catalog",
+    state,
+    countyName,
+    countyFips: /^\d{5}$/.test(text(row.countyFips, 5)) ? text(row.countyFips, 5) : "",
+    apn: text(row.apn || row.parcel, 64),
+    address: text(row.address, 200),
+    principalDollars: money(row.lienAmount ?? row.principal),
+    askingDollars: "",
+    certificateNumber: "",
+    certificateYear: "",
+    publicNotes: "",
+    portfolioRef: null,
+  };
+  return {
+    ok: true,
+    prefill,
+    dropped: ["estimatedValue", "discount", "photos"],
+    notice: "Opened from the public research catalog. That row is a county lien record, not an offer of sale and not proof you hold a certificate. Estimated value was not copied. Certificate number and asking price stay blank until you enter them.",
+  };
+}
diff --git a/src/marketplace/money.js b/src/marketplace/money.js
new file mode 100644
index 0000000..8e1c08f
--- /dev/null
+++ b/src/marketplace/money.js
@@ -0,0 +1,73 @@
+/** Integer cents only. Null means unknown — never coerce unknown to zero. */
+
+export function dollarsToCents(input, { allowZero = false } = {}) {
+  if (input == null || input === "") return null;
+  const s = String(input).trim().replace(/[$,\s]/g, "");
+  if (!/^\d+(\.\d{1,2})?$/.test(s)) {
+    const err = new Error("Enter a positive dollar amount with at most two decimal places.");
+    err.code = "BAD_AMOUNT";
+    throw err;
+  }
+  const [d, c = ""] = s.split(".");
+  const cents = Number(d) * 100 + Number(c.padEnd(2, "0"));
+  if (!Number.isSafeInteger(cents) || cents > 100_000_000_00) {
+    const err = new Error("Amount is outside the supported range.");
+    err.code = "BAD_AMOUNT";
+    throw err;
+  }
+  if (cents === 0 && !allowZero) {
+    const err = new Error("Amount must be greater than zero.");
+    err.code = "BAD_AMOUNT";
+    throw err;
+  }
+  if (cents < 0) {
+    const err = new Error("Amount must be greater than zero.");
+    err.code = "BAD_AMOUNT";
+    throw err;
+  }
+  return cents;
+}
+
+export function formatCents(cents) {
+  if (cents == null || Number.isNaN(Number(cents))) return "Not documented";
+  const n = Number(cents);
+  const sign = n < 0 ? "-" : "";
+  const abs = Math.abs(n);
+  const d = Math.floor(abs / 100);
+  const c = String(abs % 100).padStart(2, "0");
+  return `${sign}$${d.toLocaleString("en-US")}.${c}`;
+}
+
+/** Sum only known components. Unknown fees stay unknown — they are not zero. */
+export function indicativeBuyerCost({ askingPriceCents, countyFeeCents, settlementFeeCents, marketplaceFeeCents }) {
+  const parts = [
+    ["Asking price", askingPriceCents],
+    ["County assignment fee", countyFeeCents],
+    ["Settlement fee", settlementFeeCents],
+    ["Marketplace fee", marketplaceFeeCents],
+  ];
+  const known = parts.filter(([, v]) => v != null);
+  const unknown = parts.filter(([, v]) => v == null).map(([k]) => k);
+  const sum = known.reduce((a, [, v]) => a + v, 0);
+  return {
+    knownCents: known.length ? sum : null,
+    incomplete: unknown.length > 0,
+    unknown,
+    note: unknown.length
+      ? `Incomplete. Not included because they are not documented: ${unknown.join(", ")}. Missing fees are not zero.`
+      : "All listed components are documented. This is not a redemption payoff and not a return.",
+  };
+}
+
+/** Asking vs a named basis. Not a yield. */
+export function priceVersus(askingPriceCents, basisCents, basisLabel) {
+  if (askingPriceCents == null || basisCents == null) return null;
+  const diff = askingPriceCents - basisCents;
+  const gap = formatCents(Math.abs(diff));
+  const note = diff === 0
+    ? `Asking price equals ${basisLabel}.`
+    : diff > 0
+      ? `Asking price is ${gap} above ${basisLabel}.`
+      : `Asking price is ${gap} below ${basisLabel}.`;
+  return { basisLabel, differenceCents: diff, note: `${note} This comparison is not a return.` };
+}
diff --git a/src/marketplace/session.js b/src/marketplace/session.js
new file mode 100644
index 0000000..29c8514
--- /dev/null
+++ b/src/marketplace/session.js
@@ -0,0 +1,111 @@
+/** Member drafts stay on this browser under the signed-in account. The review ledger is a separate device copy. Neither one publishes to other members. */
+import { createLedger } from "./engine.js";
+import { syncStatus } from "../lib/storage.js";
+
+const REVIEW_KEY = "hotl:market:ledger:v1";
+const ACTORS_KEY = "hotl:market:actors:v1";
+const CURRENT_KEY = "hotl:market:actor:v1";
+
+let ledgers = new Map();
+const listeners = new Set();
+
+function readJSON(key, fallback) {
+  try {
+    const raw = localStorage.getItem(key);
+    return raw ? JSON.parse(raw) : fallback;
+  } catch {
+    return fallback;
+  }
+}
+
+export function marketScope() {
+  const status = syncStatus();
+  return status.signedIn && status.userId ? status.userId : "review";
+}
+
+function storageKey(scope) {
+  return scope === "review" ? REVIEW_KEY : `hotl:market:member:${scope}`;
+}
+
+function ledgerInstance(scope = marketScope()) {
+  if (!ledgers.has(scope)) {
+    const ledger = createLedger(readJSON(storageKey(scope), null) || undefined);
+    if (scope !== "review") ledger.setAudience("member");
+    ledgers.set(scope, ledger);
+  }
+  return ledgers.get(scope);
+}
+
+function persist(scope = marketScope()) {
+  const ledger = ledgers.get(scope);
+  if (!ledger) return;
+  try { localStorage.setItem(storageKey(scope), JSON.stringify(ledger.snapshot())); } catch { /* quota stays visible via the failed command */ }
+}
+
+export function subscribeMarket(fn) {
+  listeners.add(fn);
+  return () => listeners.delete(fn);
+}
+function emit() { listeners.forEach((fn) => fn()); }
+
+if (typeof window !== "undefined") {
+  window.addEventListener("hotl:account-switch", () => emit());
+}
+
+export function localActors() {
+  const rows = readJSON(ACTORS_KEY, null);
+  if (rows?.length) return rows;
+  const id = crypto.randomUUID();
+  const created = [{ id, label: "Local identity 1" }];
+  localStorage.setItem(ACTORS_KEY, JSON.stringify(created));
+  localStorage.setItem(CURRENT_KEY, id);
+  return created;
+}
+
+export function currentActorId() {
+  const rows = localActors();
+  let id = localStorage.getItem(CURRENT_KEY);
+  if (!rows.some((r) => r.id === id)) id = rows[0].id;
+  localStorage.setItem(CURRENT_KEY, id);
+  return id;
+}
+
+export function switchActor(id) {
+  const rows = localActors();
+  if (!rows.some((r) => r.id === id)) return currentActorId();
+  localStorage.setItem(CURRENT_KEY, id);
+  emit();
+  return id;
+}
+
+export function addLocalActor() {
+  const rows = localActors();
+  if (rows.length >= 3) return rows;
+  const row = { id: crypto.randomUUID(), label: `Local identity ${rows.length + 1}` };
+  const next = [...rows, row];
+  localStorage.setItem(ACTORS_KEY, JSON.stringify(next));
+  localStorage.setItem(CURRENT_KEY, row.id);
+  emit();
+  return next;
+}
+
+export function marketView(actorId) {
+  const scope = marketScope();
+  const id = scope === "review" ? actorId : scope;
+  return { ...ledgerInstance(scope).view(id), remote: scope !== "review", memberCopy: scope !== "review" };
+}
+
+export async function marketCommand(actor, name, payload, opts) {
+  const scope = marketScope();
+  const id = scope === "review" ? actor?.id : scope;
+  const res = await ledgerInstance(scope).command({ id }, name, payload, opts);
+  if (res.ok) persist(scope);
+  emit();
+  return res;
+}
+
+export function marketTasks(actorId) {
+  const scope = marketScope();
+  const id = scope === "review" ? actorId : scope;
+  return ledgerInstance(scope).view(id).tasks;
+}
diff --git a/supabase/migrations/20261006120000_marketplace.sql b/supabase/migrations/20261006120000_marketplace.sql
