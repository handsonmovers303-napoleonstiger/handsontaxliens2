--- /dev/null
+++ b/public/sw.js
@@ -0,0 +1,37 @@
+/* Sale alerts only. The page posts a SHOW message. A future push server can send the same JSON. */
+self.addEventListener("push", (event) => {
+  let payload = {};
+  try { payload = event.data ? event.data.json() : {}; } catch { payload = { body: event.data && event.data.text() }; }
+  event.waitUntil(self.registration.showNotification(payload.title || "Tax sale alert", {
+    body: payload.body || "A sale date on file is inside your lead time.",
+    tag: payload.tag || "hotl-sale",
+    data: { url: payload.url || "./#/calendar" },
+  }));
+});
+
+self.addEventListener("message", (event) => {
+  const data = event.data || {};
+  if (data.type !== "SHOW" || !data.title) return;
+  event.waitUntil(self.registration.showNotification(data.title, {
+    body: data.body || "",
+    tag: data.tag || "hotl-sale",
+    data: { url: data.url || "./#/calendar" },
+  }));
+});
+
+self.addEventListener("notificationclick", (event) => {
+  event.notification.close();
+  const url = (event.notification.data && event.notification.data.url) || "./#/calendar";
+  event.waitUntil(clients.matchAll({ type: "window", includeUncontrolled: true }).then((list) => {
+    for (const client of list) {
+      if (client.url && client.url.includes("#/calendar") && "focus" in client) return client.focus();
+    }
+    for (const client of list) {
+      if ("focus" in client) {
+        if (client.navigate) client.navigate(url);
+        return client.focus();
+      }
+    }
+    if (clients.openWindow) return clients.openWindow(url);
+  }));
+});
diff --git a/server/dispatch.js b/server/dispatch.js
new file mode 100644
index 0000000..d2a18d0
--- /dev/null
+++ b/server/dispatch.js
@@ -0,0 +1,20 @@
+import { presentAlerts, salePushPayload, upcomingAlerts } from "../src/holo/saleAlerts.js";
+
+export function planPushes(subs, events, today, sent, base = "/") {
+  const jobs = [];
+  for (const sub of subs) {
+    if (!sub?.subscription?.endpoint?.startsWith("https://") || !sub.subscription.keys?.p256dh || !sub.subscription.keys?.auth) continue;
+    const alerts = presentAlerts(upcomingAlerts(events, {
+      today,
+      leadDays: sub.leadDays,
+      watch: sub.watch || [],
+      allSales: !!sub.allSales,
+    }));
+    for (const alert of alerts) {
+      const dedupe = `${sub.subscription.endpoint}|${alert.id}`;
+      if (sent.has(dedupe)) continue;
+      jobs.push({ dedupe, subscription: sub.subscription, payload: salePushPayload(alert, base) });
+    }
+  }
+  return jobs;
+}
