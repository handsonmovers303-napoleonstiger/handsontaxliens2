+        {dayEvents.map((e) => (
+          <div key={e.id} className="row between wrap" style={{ gap: 8 }}>
+            <div>
+              <b>{e.name} County, {e.state}</b>
+              <div className="faint">{e.kind === "registration" ? "Registration deadline" : `${e.instrument} sale`} · {e.level === "DERIVED" ? "Derived" : e.level === "LIVE" ? "Live correction" : "On file"}{e.days != null ? ` · ${e.days < 0 ? `${-e.days}d ago` : e.days === 0 ? "today" : `${e.days}d`}` : ""}</div>
+              {e.note && <div className="faint">{e.note}</div>}
+            </div>
+            <div className="row wrap" style={{ gap: 6 }}>
+              <button className={`chip btn-chip ${watch.has(e.key) ? "cy" : ""}`} onClick={() => toggleWatch(e.key)} aria-pressed={watch.has(e.key)}>{watch.has(e.key) ? "Watching" : "Watch"}</button>
+              <button className="btn ghost sm" onClick={() => go("counties", { focus: e.countyId })}>County file</button>
+            </div>
+          </div>
+        ))}
+      </div>
+      <button className="btn ghost sm" onClick={() => go("auction")}><Icon n="bolt" s={14} /> Auction desk</button>
+    </div>
+  );
+}
