diff --git a/tests/pushDispatch.test.js b/tests/pushDispatch.test.js
new file mode 100644
index 0000000..17ed636
--- /dev/null
+++ b/tests/pushDispatch.test.js
@@ -0,0 +1,31 @@
+import fs from "node:fs";
+import { describe, expect, it } from "vitest";
+import { planPushes } from "../server/dispatch.js";
+import { saleEventsFromSource } from "../server/sales.js";
+
+const text = fs.readFileSync(new URL("../src/legacy/ScoutingDept.jsx", import.meta.url), "utf8");
+const events = saleEventsFromSource(text);
+const sub = { endpoint: "https://push.example/device", keys: { p256dh: "k", auth: "a" } };
+
+describe("push server dates", () => {
+  it("reads bundled sale dates and does not invent one", () => {
+    expect(events.find((e) => e.key === "CO|Mesa")).toMatchObject({ iso: "2026-10-16", level: "ON_FILE" });
+    expect(events.find((e) => e.key === "IA|Polk").level).toBe("DERIVED");
+    expect(events.find((e) => e.key === "CO|Routt" && e.kind === "registration").iso).toBe("2026-10-29");
+    expect(events.some((e) => !e.iso)).toBe(false);
+  });
+
+  it("sends one grouped alert for a watched county and does not repeat it", () => {
+    const subs = [{ subscription: sub, watch: ["CO|Mesa"], leadDays: 7, allSales: false }];
+    const first = planPushes(subs, events, "2026-10-10", new Set());
+    expect(first.map((j) => j.payload.title)).toEqual(["Tax sale in 6 days"]);
+    expect(first[0].payload.body).toContain("Mesa");
+    const again = planPushes(subs, events, "2026-10-10", new Set(first.map((j) => j.dedupe)));
+    expect(again).toHaveLength(0);
+  });
+
+  it("refuses a subscription with no endpoint", () => {
+    const jobs = planPushes([{ subscription: { endpoint: "http://nope" }, watch: ["CO|Mesa"], leadDays: 30, allSales: true }], events, "2026-10-10", new Set());
+    expect(jobs).toHaveLength(0);
+  });
+});
diff --git a/tests/saleAlerts.test.js b/tests/saleAlerts.test.js
new file mode 100644
index 0000000..76210c0
--- /dev/null
+++ b/tests/saleAlerts.test.js
@@ -0,0 +1,34 @@
+import { describe, expect, it } from "vitest";
+import { alertCopy, presentAlerts, salePushPayload, upcomingAlerts } from "../src/holo/saleAlerts.js";
+
+const sale = (extra) => ({ id: "1", kind: "sale", key: "CO|Mesa", name: "Mesa", state: "CO", iso: "2026-10-16", level: "ON_FILE", ...extra });
+
+describe("sale alerts", () => {
+  it("alerts only inside the lead window for watched counties", () => {
+    const events = [
+      sale({}),
+      sale({ id: "2", key: "CO|Delta", name: "Delta", iso: "2026-11-05" }),
+      sale({ id: "3", key: "AZ|Maricopa", name: "Maricopa", state: "AZ", iso: "2027-02-01" }),
+    ];
+    const got = upcomingAlerts(events, { today: "2026-10-10", leadDays: 7, watch: ["CO|Mesa"], allSales: false });
+    expect(got.map((e) => e.key)).toEqual(["CO|Mesa"]);
+    expect(got[0].days).toBe(6);
+  });
+
+  it("does not invent a date or alert a past sale", () => {
+    const got = upcomingAlerts([sale({ iso: "2026-10-01" }), { kind: "sale", key: "XX|Nope", name: "Nope", state: "XX", iso: "" }], { today: "2026-10-10", leadDays: 30, watch: ["CO|Mesa", "XX|Nope"], allSales: true });
+    expect(got).toHaveLength(0);
+  });
+
+  it("folds a derived same-day cycle into one alert", () => {
+    const events = ["Adair", "Adams", "Allamakee", "Appanoose"].map((name, i) => sale({ id: String(i), key: `IA|${name}`, name, state: "IA", iso: "2027-06-21", level: "DERIVED" }));
+    const shown = presentAlerts(upcomingAlerts(events, { today: "2027-06-01", leadDays: 30, watch: [], allSales: true }));
+    expect(shown).toHaveLength(1);
+    expect(shown[0].name).toMatch(/4 IA counties/);
+    expect(alertCopy(shown[0]).body).toMatch(/Derived/);
+    const payload = salePushPayload(shown[0], "/handsontaxliens/");
+    expect(payload.type).toBe("SHOW");
+    expect(payload.url).toBe("/handsontaxliens/#/calendar");
+    expect(payload.tag).toBe(shown[0].id);
+  });
+});
